# ═══════════════════════════════════════════════════════════════
# AMN-Stock — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ⚠️  Ne jamais committer le .env réel dans Git
# ═══════════════════════════════════════════════════════════════

# ── Django ──────────────────────────────────────────────────────
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=remplacer-par-une-chaine-aleatoire-de-50-caracteres-minimum

# True en dev local, False en production obligatoirement
DEBUG=True

# Séparés par des virgules — en prod : votre-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# En production uniquement (inutile en dev)
# CSRF_TRUSTED_ORIGINS=https://votre-app.onrender.com

# ── Base de données ──────────────────────────────────────────────
# Laisser vide en dev local → SQLite automatique
# En prod → URL NeonDB pooled :
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── Redis / Celery ───────────────────────────────────────────────
# Dev local : redis://localhost:6379/0
# Production (Upstash) : rediss://default:TOKEN@HOST:PORT
CELERY_BROKER_URL=redis://localhost:6379/0

# ── Email — Brevo (SMTP) ─────────────────────────────────────────
# 1. Créer un compte sur brevo.com
# 2. Menu → Transactional → SMTP & API → Generate new SMTP key
# 3. Copier le login SMTP (format : xxxxxxxx@smtp-brevo.com)
#    et la clé générée ci-dessous
#
# En dev, utiliser le backend console pour ne pas envoyer de vrais emails :
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# En production, remplacer par :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
# Login SMTP affiché dans Brevo → SMTP & API (ex: 7a3f2b001@smtp-brevo.com)
EMAIL_HOST_USER=votre-login@smtp-brevo.com
# Clé SMTP générée dans Brevo (≠ mot de passe du compte Brevo)
EMAIL_HOST_PASSWORD=votre-cle-smtp-brevo

DEFAULT_FROM_EMAIL=AMN Stock <noreply@amn.africa>
ADMIN_EMAIL=admin@amn.africa

# ── Application ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8000
LOW_STOCK_THRESHOLD=5

# ── Groq AI (assistant vocal + rapports IA) ─────────────────────
# Obtenir la clé sur https://console.groq.com/keys
GROQ_API_KEY=gsk_votre_cle_groq

# ── Green API (alertes WhatsApp) ─────────────────────────────────
# 1. Créer un compte sur https://console.green-api.com/
# 2. Créer une instance → scanner le QR code avec WhatsApp
GREENAPI_INSTANCE_ID=votre_instance_id
GREENAPI_TOKEN=votre_token
# Numéro destinataire sans + (ex: Cameroun +237 6XX XX XX XX → 237600000000)
GREENAPI_RECIPIENT=237600000000
GREENAPI_BASE_URL=https://api.green-api.com
