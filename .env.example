# Copy to .env and fill in values
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (use console backend for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@amn.africa
ADMIN_EMAIL=admin@amn.africa

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# Stock threshold for low-stock alerts
LOW_STOCK_THRESHOLD=5

# ── Green API — WhatsApp ────────────────────────────────────────────────────
# 1. Créer un compte sur https://console.green-api.com/
# 2. Créer une instance et scanner le QR code avec WhatsApp
# 3. Copier l'ID d'instance et le token ci-dessous
GREENAPI_INSTANCE_ID=1234567890
GREENAPI_TOKEN=your_greenapi_token_here
# Numéro cible (sans +) : indicatif pays + numéro local
# Cameroun (+237) : 237678317658
GREENAPI_RECIPIENT=237678317658
# Laisser vide pour utiliser l'URL par défaut
GREENAPI_BASE_URL=https://api.green-api.com
